module zrv_booth_mul (
    input  wire [64:0] rs1,
    input  wire [64:0] rs2,

    input  wire i_alu_mul_req,

    //output wire [127:0] mul_res, 
    //output reg  o_alu_mul_ack,
    output wire [127:0] mul_cas_res1, 
    output wire [127:0] mul_cas_res2 
    
//    input  wire clk,
